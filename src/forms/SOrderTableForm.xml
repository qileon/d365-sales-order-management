			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// Positions the form on the record passed by the caller, if any.
    /// </summary>
    public void init()
    {
        SOrderTable orderTable;
        Query query;
        QueryBuildDataSource qbds;

        super();

        if (element.args() && element.args().record()
            && element.args().record().TableId == tableNum(SOrderTable))
        {
            orderTable = element.args().record();

            if (orderTable.RecId)
            {
                query = SOrderTable_ds.query();
                qbds = query.dataSourceTable(tableNum(SOrderTable));
                qbds.clearRanges();
                qbds.addRange(fieldNum(SOrderTable, RecId)).value(queryValue(orderTable.RecId));
            }
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>updateActionButtons</Name>
				<Source><![CDATA[
    /// <summary>
    /// Updates the enabled state of form actions and line datasource.
    /// </summary>
    private void updateActionButtons()
    {
        boolean isDraft;

        isDraft = (SOrderTable.Status == SOrderStatus::Draft);

        SOrderLine_ds.allowCreate(isDraft);
        SOrderLine_ds.allowEdit(isDraft);
        SOrderLine_ds.allowDelete(isDraft);
    }

]]></Source>
			</Method>
		</Methods>
