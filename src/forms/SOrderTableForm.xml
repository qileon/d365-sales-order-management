				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        /// <summary>
        /// Executes the approve action for the current sales order.
        /// </summary>
        public void clicked()
        {
            super();

            try
            {
                SOrderService::approveOrder(
                    SOrderTable.OrderId);

                SOrderTable_ds.reread();
                SOrderTable_ds.refresh();

                SOrderLine_ds.executeQuery();

                element.updateActionButtons();
            }
            catch (Exception::Error)
            {
            }
        }

]]></Source>
